; Standalone study of a 3D hand model. NOT part of the game.
; Numbers live in hand_model.gd; frames go to /tmp/opencode/hand3d.
config_version=5

[application]

config/name="MBT Hand 3D"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=1000
window/size/viewport_height=1200
window/size/mode=0
window/stretch/mode="disabled"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
