.venv/
game/dist/
game/.godot/
game/.gradle/
game/?/
__pycache__/
progress.json

# Рабочие временные файлы агента внутри репозитория (решение 25.10.2026:
# /tmp у автора — tmpfs и обнуляется при перезагрузке; скрипты хода
# работы, промежуточные пусть живут тут). В коммиты никогда не идут.
.tmp/

# tools/: в репозитории лежат скрипты сборки (tools/docker), генератор
# иконок (tools/icons), хелперы визуального стенда (tools/x11test.py,
# tools/verify_vis.py — сверка кадров партии с моделью по пикселям),
# скрипт эмулятора (tools/emulator/run-emu.sh) и исходники нативного
# плагина MbtInstall (tools/plugin/mbt-install: Java-мост для установки
# APK и шаринга файлов — без него обновление из игры невозможно).
# Всё остальное — кэши и шаблоны, которые пересоздаются: export
# templates (1.7 ГБ), бинарь движка, SDK и образы эмулятора, собранные
# AAR и каталог gradle-сборки Android (game/android/build разворачивает
# build-game.sh из шаблона образа при первом Android-экспорте).
tools/*
!tools/docker/
!tools/icons/
!tools/x11test.py
!tools/verify_vis.py
!tools/plugin/
tools/plugin/*
!tools/plugin/mbt-install/
# Стенд эмулятора: СКРИПТ и ПРОФИЛЬ AVD (геометрия телефона 1080x2280,
# dpi 420) — в репозитории, иначе с чистого клона стенд не поднять.
# SDK, образы и сам AVD — нет: sdkmanager/avdmanager качают и создают их
# заново (run-emu.sh делает это сам, см. AGENTS.md §6).
!tools/emulator/
tools/emulator/*
!tools/emulator/run-emu.sh
!tools/emulator/avd/
tools/emulator/avd/*
!tools/emulator/avd/mbt.config.ini
# 3D-исследование кистей — ИСХОДНИК запечённых поз и силуэта
# (hands_poses.gd, hands_shape.gd печёт из него). Кэши, кадры и меши
# пересоздаются скриптами печи — они не нужны.
!tools/hand3d/
tools/hand3d/*
!tools/hand3d/*.gd
!tools/hand3d/*.tscn
!tools/hand3d/*.md
!tools/hand3d/*.py
!tools/hand3d/*.sh
!tools/hand3d/project.godot

# Gradle-сборка Android: генерированное (90МБ godot-lib, ассеты,
# .import-мусор). Наш AAR кладётся туда скриптом из
# tools/plugin/mbt-install/aar, версия шаблона — из
# game/android/.build_version (он закоммичен отдельно).
game/android/build/
